{
  "name": "backend-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "build:core-errors": "npm run build --prefix core/errors",
    "build:core-messages": "npm run build --prefix core/messages",
    "build:core-jwt": "npm run build --prefix core/jwt",
    "build:core-logger": "npm run build --prefix core/logger",
    "build:core-db": "pnpm prisma:generate && npm run build --prefix core/db",
    "build:core-repository": "npm run build --prefix core/repository",
    "build": "npm run build:core-errors && npm run build:core-messages && npm run build:core-jwt && npm run build:core-logger && npm run build:core-db && npm run build:core-repository && tsc",
    "dev": "cross-env NODE_ENV=development nodemon --exec ts-node src/index.ts",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "ci": "pnpm lint && pnpm typecheck && pnpm prisma:validate && pnpm test && pnpm build"
  },
  "dependencies": {
    "@app-core/db": "workspace:*",
    "@app-core/errors": "workspace:*",
    "@app-core/jwt": "workspace:*",
    "@app-core/logger": "workspace:*",
    "@app-core/messages": "workspace:*",
    "@app-core/repository": "workspace:*",
    "@clerk/express": "^2.1.15",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "prisma": "^7.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
